# Environment variables for reference-app
APP_ENV=development
HTTP_ADDRESS=:8080
# DATABASE_URL is injected from Secret Manager in deployed environments.
JWT_SECRET=supersecretjwtkey
JWT_ISSUER=reference-app
JWT_AUDIENCE=reference-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
GOOGLE_PROJECT_ID=my-google-project-id
GCS_BUCKET=my-gcs-bucket
LOG_LEVEL=DEBUG
